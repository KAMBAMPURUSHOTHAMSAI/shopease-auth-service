# Copy this file to .env and replace every example password/secret before running.
APP_NAME=ShopEase Authentication Service
APP_VERSION=1.0.0
APP_DESCRIPTION=JWT-based authentication microservice for ShopEase.
APP_PORT=8002

# Local host settings. Docker Compose overrides DB_HOST and DB_PORT for the API container.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=shopease_auth_db
DB_USER=shopease_auth_user
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD_123!
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD_123!

JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=shopease-auth-service
